# Copy to .env.local and fill in. Never commit real values.

# Random 32-byte secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
# Authorised redirect URI (local): http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Dashboard subdomain (PayXa DashBoard app) ──────────────────────
# When set, login sends merchants to the dashboard subdomain and /dashboard here redirects there.
# Local: http://localhost:3300   Production: https://dashboard.payxa.com
NEXT_PUBLIC_DASHBOARD_URL=
# Share the login cookie with the subdomain. Empty on localhost. Production: .payxa.com
# Must match AUTH_COOKIE_DOMAIN in the dashboard app (and AUTH_SECRET must be identical too).
AUTH_COOKIE_DOMAIN=

# Development only: shows "Continue as test merchant" on the login page.
# Ignored in production builds.
AUTH_TEST_LOGIN=true

# Cloudflare Turnstile Configuration
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=payxa.in,api.payxa.in,dashboard.payxa.in

# PayXa Centralized SSO Configuration
DASH_SSO_SHARED_SECRET=
API_BASE_URL=https://payxa-api.payxa.workers.dev

# Supabase Integration
SUPABASE_URL=
SUPABASE_SECRET_KEY=
