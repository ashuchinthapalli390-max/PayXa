# Copy to .env.local or set in your deployment dashboard (e.g. Vercel). Never commit real secrets.

# ── 1. URLs & Domains ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://payxa.in
# Dashboard: https://dash.payxa.in
NEXT_PUBLIC_DASHBOARD_URL=https://dash.payxa.in
NEXT_PUBLIC_API_URL=https://api.payxa.in
API_BASE_URL=https://api.payxa.in

# ── 2. Shared Session Authentication (Auth.js) ────────────────────────────────
# Random 32-byte secret: `npx auth secret` or `openssl rand -base64 32`
# Must be identical across PayXa Public and PayXa DashBoard to share sessions
AUTH_SECRET=
# Domain to share cookie across subdomains (e.g. .payxa.in in production; empty locally)
AUTH_COOKIE_DOMAIN=.payxa.in
AUTH_SESSION_COOKIE=__Secure-authjs.session-token

# Google OAuth client
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
# Authorised redirect URI: https://payxa.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Development only: shows "Continue as test merchant" on the login page.
# Must be false for production.
AUTH_TEST_LOGIN=false

# ── 3. Cloudflare Turnstile Bot Protection ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=payxa.in,api.payxa.in,dash.payxa.in

# ── 4. PayXa Centralized SSO Configuration ────────────────────────────────────
DASH_SSO_SHARED_SECRET=

# ── 5. Supabase Integration (Shared Role & Access Truth) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

